<?xml version="1.0" encoding="UTF-8"?>
<!--
  知识库 MCP Server（Model Context Protocol）

  给转型同学的话：
  - 本项目演示【生产主流写法】：MCP 协议层交给官方生态实现，自己只写业务工具。
      · 传输层：Spring AI MCP Server Starter（底层是官方 MCP Java SDK）
      · 工具注册：Spring AI 的 @Tool 注解 + ToolCallbackProvider，启动时自动扫描发布
      · 检索：Apache Lucene（BM25 相似度 + SmartChineseAnalyzer 中文分词）
  - 想"看清协议长什么样"？不用看源码：启动后对 /mcp 发 tools/list，
    或用 MCP Inspector 连上来，报文一目了然（README 有命令）。
  - 版本对应关系（都写在 properties 里，改版本只改一处）：
      Spring Boot 3.5.3（父工程，决定 JDK/依赖基线）
      Spring AI 1.1.8（MCP Server Starter 所在版本线，与 Boot 3.5.x 配套）
      Lucene 9.12.3（9.x 线支持 Java 11+，与 release 17 兼容；10.x 需要 Java 21）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>kb-mcp-server</artifactId>
    <version>1.0.0</version>
    <name>kb-mcp-server</name>
    <description>把知识库检索能力封装为 MCP Server，供 Claude/Cursor/任意 Agent 调用</description>

    <properties>
        <java.version>17</java.version>
        <spring-ai.version>1.1.8</spring-ai.version>
        <lucene.version>9.12.3</lucene.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI BOM：统一管理 MCP / 工具 / 模型相关构件版本，避免版本打架 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web（Servlet 栈）：MCP Streamable HTTP 端点是标准的 Servlet/路由端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          MCP Server（WebMvc 版）：一个 starter 搞定传输层 + 协议层 + 工具发布。
          它自动装配出 McpSyncServer，并把容器里所有 ToolCallback / ToolCallbackProvider
          Bean 转成 MCP 工具，无需手写 tools/list、tools/call。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- ===== Apache Lucene：工业级全文检索（BM25 由 Lucene 负责，不用自己算） ===== -->
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-core</artifactId>
            <version>${lucene.version}</version>
        </dependency>
        <!-- 查询解析：把用户输入的字符串解析成 Lucene Query -->
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-queryparser</artifactId>
            <version>${lucene.version}</version>
        </dependency>
        <!-- 分析器公共依赖（分词器基类、Filter 等） -->
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-analysis-common</artifactId>
            <version>${lucene.version}</version>
        </dependency>
        <!-- 中文分词：SmartChineseAnalyzer（中文词库 + 未登录词识别，中文检索的事实标准之一） -->
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-analysis-smartcn</artifactId>
            <version>${lucene.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
