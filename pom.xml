<?xml version="1.0" encoding="UTF-8"?>
<!--
  知识库 MCP Server（Model Context Protocol）

  给转型同学的话：
  - MCP（Model Context Protocol）是 Anthropic 提出的开放协议，用于把"工具/数据源"
    标准化地暴露给大模型应用。Claude Desktop、Cursor、以及各种 Agent 框架都能作为
    MCP 客户端接入本服务。
  - 本项目【零 AI 依赖】：只用 Spring Web 手写实现了 MCP 的 HTTP+SSE 传输层和
    JSON-RPC 2.0 消息协议。目的：一是无外部 SDK 版本风险、开箱即跑；
    二是让你能亲眼看到 MCP 协议的每一条报文，学习协议本身而不是黑盒 SDK。
  - 检索实现为 BM25 关键词检索（与项目一同款思路的简化版），
    你可以自行替换为项目一里的向量检索，把它升级为"语义检索 MCP Server"。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>kb-mcp-server</artifactId>
    <version>1.0.0</version>
    <name>kb-mcp-server</name>
    <description>把知识库检索能力封装为 MCP Server，供 Claude/Cursor/任意 Agent 调用</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Jackson 已随 starter-web 引入，这里显式声明仅为强调协议序列化用到的能力 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
